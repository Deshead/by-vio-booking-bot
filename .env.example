# Obtain this from @BotFather. Never commit your real .env.
BOT_TOKEN=

# Portfolio: each visitor has an isolated demo and a private master dashboard.
# Real salon: set false and list trusted Telegram IDs below.
DEMO_MODE=true
ADMIN_IDS=

# A persistent volume must contain this path in production.
BOOKING_DB_PATH=data/bookings.sqlite3

# Local Windows: leave blank to use the system proxy.
# Server: direct, unless that server requires its own proxy.
BOT_PROXY_URL=

# Optional HTTP health endpoint /health. Containers set this to 8080.
PORT=0
